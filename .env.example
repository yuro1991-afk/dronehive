# Optional overrides for DroneHive
# DRONE_HIVE_ROOT=C:\path\to\workspace
# DRONE_HIVE_HOST=127.0.0.1
# DRONE_HIVE_PORT=8765
# DRONE_HIVE_LANE=fast
# DRONE_HIVE_WEBHOOK=https://example.com/hook
# DRONE_PYTHON=C:\Users\you\AppData\Local\Programs\Python\Python312\python.exe

# --- SpaceXAI (default cloud provider — xAI API; never commit real keys) ---
# Provider name in product: SpaceXAI. Env/endpoints are xAI.
# Docs: https://docs.x.ai/developers/models  (default model: grok-4.5)
# XAI_API_KEY=xai-...
# DRONE_XAI_MODEL=grok-4.5
# Optional Gemini cloud (secondary; prefer SpaceXAI for Grok features)
# GEMINI_API_KEY=
# DRONE_GEMINI_MODEL=gemini-2.0-flash
