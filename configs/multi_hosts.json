    "strict_m2m": true
  },
  "super_mesh": {
    "enabled": true,
    "hardwire": "G:\\AI-Home\\projects\\ai-worker-drone-0.5b\\data\\super_mesh\\HARDWIRE.json",
    "config": "configs/super_mesh.json",
    "roster": "configs/m2m_node_roster.json",
    "m2m_live": [
      "m2m-probe",
      "m2m-scout",
      "m2m-map",
      "m2m-plan",
      "m2m-tool",
      "m2m-code",
      "m2m-parse",
      "m2m-ops",
      "m2m-left",
      "m2m-seal",
      "m2m-flash",
      "m2m-recall",
