include README.md
include LICENSE
include pyproject.toml
include requirements.txt
include requirements-desktop.txt
include DroneHive.spec
include INSTALL.bat
include INSTALL_DESKTOP.bat
include START_APP.bat
include START_DESKTOP.bat
include COMMISSION.bat
include RUN_*.bat

recursive-include configs *.json
recursive-include docs *.md
recursive-include static *
recursive-include scripts *.ps1 *.py *.cmd
recursive-include drone/app/seed *

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .git*
global-exclude data/**
global-exclude out/**
global-exclude build/**
global-exclude dist/**
global-exclude *.egg-info/**
